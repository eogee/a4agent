# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 运行时数据
backend/database/

# 打包产物
build/
dist/
*.spec

# uv 导出的依赖清单（由 pyproject.toml 生成，勿手改，不入库）
backend/requirements.txt

# 第三方 source map（仅本地调试用，不随包分发）
frontend/layui/**/*.map

# 调试过程产物（界面探针截图与抓取数据）
.run/

# 编辑器
.idea/
.vscode/


# agents（含密钥与本地脚本，整体不入库）
.agents/
.claude/
.codex/
.cursor/
.impeccable/
.zcode/
.dsh/
.opencode/
.pi/
.qoder/

# 浏览器调试产物（截图、快照、控制台日志）
.playwright-mcp/


# 开发文档：只保留 README / 后端 API 引用的迁移对照表（用户可见），
# 其余调研、实施、测试记录均为维护者本地过程文档，不入库。
docs/*
!docs/迁移对照表-三端API配置.md

开发文档.md

DESIGN.md
PRODUCT.md

# cache
.mypy_cache
.pytest_cache
.ruff_cache
.uv-cache/
.coverage
htmlcov/

# 环境变量与凭据（避免误提交密钥）
.env
.env.*

# 系统与临时文件
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp
# 反馈邮件凭据（私有，不入库；缺失时反馈仅入库不发邮件）
backend/app/mail_secrets.py

# logo 设计过程产物（定稿已落在 resources/ 与 frontend/）
/logo/

# 工作区记忆目录（本地运行时数据，不入库）
.workbuddy/
