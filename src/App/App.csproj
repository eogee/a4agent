<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>a4agent</AssemblyName>
    <ApplicationIcon>a4agent.ico</ApplicationIcon>
    <RootNamespace>a4agent.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 更新检查以程序集版本为准；发布时 build.ps1 会用 -p:Version 覆盖为安装包同版本 -->
    <Version>0.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <!-- 控制台 UI 宿主（Win10/11 一般自带 WebView2 Runtime；缺失时降级为系统浏览器打开） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- layui 控制台前端整体内嵌进程序集，由 ControlServer 从内存直出（单文件发布也无需带散文件） -->
    <EmbeddedResource Include="Web\frontend\**\*.*" />
  </ItemGroup>

</Project>
